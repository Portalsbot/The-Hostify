# Telegram controller credentials (create a bot with @BotFather)
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_hostify_bot_token_here
OWNER_ID=8043083450

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Fernet key for encrypted environment variables and stored settings.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this up securely. Losing it makes encrypted values unrecoverable.
DATA_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Hostify storage paths. compose.yaml mounts both paths as persistent volumes.
BASE_DIR=/var/lib/hostify_bots
SESSION_DIR=/data

# Internal application port and optional published host port.
PORT=10000
HOSTIFY_PORT=10000

# Keep disabled unless you deliberately accept running customer code
# without Docker/OS isolation. This setting is not a sandbox.
ALLOW_UNSANDBOXED_DEPLOYMENTS=false
