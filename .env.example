# Telegram controller credentials (create a bot with @BotFather)
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_hostify_controller_bot_token_here
OWNER_ID=8043083450

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Fernet encryption key for customer bot environment variables.
# Generate once and keep it safe: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes previously encrypted customer environment values unrecoverable.
DATA_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Storage and hosting platform
BASE_DIR=/opt/hostify_bots
PORT=10000

# OFF by default. Set true only if every repository you deploy is trusted.
# This project does NOT yet isolate customer code with Docker/containers.
ALLOW_UNSANDBOXED_DEPLOYMENTS=false
