# Telegram controller credentials
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_hostify_bot_token_here
OWNER_ID=8043083450

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Fernet key for encrypted deployment environment variables.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=PASTE_GENERATED_FERNET_KEY_HERE

# Native Python service storage. Set writable persistent paths where available.
BASE_DIR=./hostify_bots
SESSION_DIR=./data
PORT=10000

# Render API integration for customer services. Keep the API key secret.
RENDER_API_KEY=
RENDER_WORKSPACE_ID=
RENDER_REGION=singapore

# GitHub App integration. Keep the private key in Render secrets.
GITHUB_APP_ID=5714509
GITHUB_APP_SLUG=the-hostify
GITHUB_APP_PRIVATE_KEY_B64=

# Off by default: customer Python code runs under the same service account.
# Only enable this when all admins and repositories are trusted.
ALLOW_UNSANDBOXED_DEPLOYMENTS=false
